{
  "name": "tvshell",
  "version": "0.2.0",
  "description": "Google TV-like remote-driven shell for Windows big screens",
  "main": "native/main.js",
  "author": "caspar",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tvshell.local.app",
    "productName": "TVShell",
    "files": ["native/**/*", "web/**/*", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "native/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "native/icon.ico"
    }
  }
}
