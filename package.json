{
  "name": "htlauncher",
  "version": "0.3.2",
  "description": "HTLauncher — Google TV-like remote-driven shell for Windows big screens",
  "main": "native/main.js",
  "author": "caspar",
  "license": "GPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "htlauncher.local.app",
    "productName": "HTLauncher",
    "files": ["native/**/*", "web/**/*", "package.json"],
    "publish": { "provider": "github", "owner": "ct06033", "repo": "HTLauncher" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
